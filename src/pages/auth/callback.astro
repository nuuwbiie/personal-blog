---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
---
<MainGridLayout title="Menyelesaikan login" description="Kembali ke percakapan.">
 <section class="card-base p-9 text-black/90 dark:text-white/90">
  <h1 class="text-2xl font-bold mb-4">Kembali ke percakapan</h1>
  <p id="auth-status" role="status">Memeriksa tautan masuk…</p>
  <a id="auth-return" href="/" class="inline-flex mt-6 underline text-[var(--primary)]" data-no-swup>Kembali ke blog</a>
 </section>
</MainGridLayout>
<script>
import {supabase} from "../../lib/supabase";
async function finish(){
 const status=document.getElementById("auth-status")!;
 const link=document.getElementById("auth-return") as HTMLAnchorElement;
 try {
  if(!supabase)throw new Error("unconfigured");
  const {data,error}=await supabase.auth.getSession();
  if(error||!data.session)throw error||new Error("expired");
  history.replaceState({},"",location.pathname);
  const path=sessionStorage.getItem("returnToPost");
  if(path && /^\/posts\/[a-zA-Z0-9_\-/]+\/$/.test(path))link.href=path;
  sessionStorage.removeItem("returnToPost");
  status.textContent="Berhasil masuk. Kamu bisa kembali ke tulisan dan melanjutkan percakapan.";
  link.textContent="Lanjutkan membaca";
 }catch{status.textContent="Tautan masuk kedaluwarsa atau dibuka di browser berbeda. Kembali ke tulisan dan minta tautan baru di browser ini.";}
}
void finish();
</script>
